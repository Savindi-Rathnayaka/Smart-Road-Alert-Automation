    {
      "parameters": {
        "jsCode": "const items = $('If').all().map(item => item.json);\n\nconst seen = new Set();\nconst out = [];\n\nfor (const a of items) {\n  const id = String(a.incident_id || '').trim();\n\n  if (!id || seen.has(id)) continue;\n\n  seen.add(id);\n\n  out.push({\n    json: {\n      ...a,\n      alert_id: id\n    }\n  });\n}\n\nreturn out;"
      },
