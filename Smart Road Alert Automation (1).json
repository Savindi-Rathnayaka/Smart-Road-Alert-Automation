    {
      "parameters": {
        "jsCode": "const items = $('Code in JavaScript').all().map(i => i.json);\n\nconst highAlerts = items.filter(i =>\nString(i.smart_alert_level || '').toUpperCase() === 'HIGH'\n);\n\nconst top = highAlerts.slice(0, 10);\n\nconst lines = top.map(i =>\n`• ${i.location} - ${i.incident_type} (${i.congestion_percent}% congestion, ${i.distance_ahead_km} km ahead)`\n);\n\nconst text =\n`🚨 SMART ROAD ALERT 🚨\\n` +\n`HIGH alerts: ${highAlerts.length}\\n\\n` +\n`Top ${top.length}:\\n` +\n`${lines.join('\\n')}\\n\\n` +\n`Please drive carefully!`;\n\nreturn [{ json: { text } }];\n\n"
      },
